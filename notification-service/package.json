{
  "name": "notification-service",
  "version": "1.0.0",
  "description": "Kafka-driven background worker that sends OTP/security emails on behalf of auth-service",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "start": "node --env-file=.env dist/index.js",
    "dev": "nodemon",
    "build": "tsc",
    "clean": "if exist dist rmdir /s /q dist",
    "lint": "biome lint .",
    "lint:fix": "biome lint . --write",
    "format": "biome format . --write",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:fix": "biome check . --write",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "kafka",
    "email",
    "notifications",
    "worker"
  ],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@10.17.1",
  "dependencies": {
    "kafkajs": "^2.2.4",
    "nodemailer": "^7.0.13",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.8",
    "@types/node": "^24.10.1",
    "@types/nodemailer": "^7.0.12",
    "nodemon": "^3.1.11",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
