NODE_ENV="development"

# PORT FOR THE /health ENDPOINT (DOCKER HEALTHCHECK). NOT THE KAFKA PORT.
HEALTH_PORT="5001"

# PINO LOG LEVEL: trace | debug | info | warn | error | fatal. DEFAULTS TO debug IN DEV, info OTHERWISE.
LOG_LEVEL="debug"

# LOCAL DEV: 127.0.0.1:9094 (KAFKA'S HOST LISTENER) | DOCKER COMPOSE: kafka:9092
KAFKA_BROKERS="127.0.0.1:9094"

SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your_smtp_user@example.com"
SMTP_PASS="your_smtp_app_password"
SMTP_FROM_NAME="Ecommerce App"

# MUST MATCH server/.env's OTP_EXPIRY_MINUTES — SHOWN IN THE EMAIL COPY, NOT ENFORCED HERE.
OTP_EXPIRY_MINUTES="10"
