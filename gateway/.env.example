NODE_ENV="development"
PORT="5003"

# PINO LOG LEVEL: trace | debug | info | warn | error | fatal. DEFAULTS TO debug IN DEV, info OTHERWISE.
LOG_LEVEL="debug"

# LOCAL DEV: redis://127.0.0.1:6379 | DOCKER COMPOSE: redis://redis:6379
REDIS_URL="redis://127.0.0.1:6379"

# LOCAL DEV: server's HOST-PUBLISHED PORTS | DOCKER COMPOSE: server:50051 / server:5000 (IN-NETWORK)
GRPC_SERVER_URL="127.0.0.1:50051"
DOCS_PROXY_TARGET="http://127.0.0.1:5000"

# MUST MATCH server/.env's JWT_SECRET EXACTLY — TOKENS ARE ISSUED BY auth-service, VERIFIED HERE.
JWT_SECRET="replace_with_a_random_string_at_least_32_characters_long"

RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX="100"
AUTH_RATE_LIMIT_MAX="10"

CLIENT_URL="http://localhost:3001"
