# DOCKER COMPOSE ORCHESTRATION SETTINGS — CONTAINER NAMES & HOST-PUBLISHED PORTS.
# COPY TO ".env" IN THE PROJECT ROOT TO OVERRIDE THE DEFAULTS. APP-LEVEL CONFIG
# STAYS IN server/.env AND client/.env.

MONGO_CONTAINER_NAME=mongodb
MONGO_PORT=27017
MONGO_DB_NAME=mern_app

REDIS_CONTAINER_NAME=redis
REDIS_PORT=6379

SERVER_CONTAINER_NAME=mern_server
SERVER_PORT=5000

NETWORK_NAME=mern_network
