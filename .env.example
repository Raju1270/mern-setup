# DOCKER COMPOSE ORCHESTRATION SETTINGS — CONTAINER NAMES & HOST-PUBLISHED PORTS.
# COPY TO ".env" IN THE PROJECT ROOT TO OVERRIDE THE DEFAULTS. APP-LEVEL CONFIG
# STAYS IN server/.env AND client/.env.

# 3-NODE REPLICA SET (rs0) — SEE mongo/init-replica-set.js. INTERNAL MEMBER HOSTS ARE ALWAYS THE
# BARE SERVICE NAMES (mongo1/mongo2/mongo3), NOT THESE CONTAINER_NAME VARS — THOSE ONLY AFFECT
# WHAT `docker ps` DISPLAYS AND THE HOST-PUBLISHED PORTS BELOW.
MONGO1_CONTAINER_NAME=mongo1
MONGO1_PORT=27017
MONGO2_CONTAINER_NAME=mongo2
MONGO2_PORT=27018
MONGO3_CONTAINER_NAME=mongo3
MONGO3_PORT=27019
MONGO_INIT_CONTAINER_NAME=mongo_init
MONGO_DB_NAME=mern_app

REDIS_CONTAINER_NAME=redis
REDIS_PORT=6379

SERVER_CONTAINER_NAME=mern_server
# INTERNAL-ONLY NOW (NOT PUBLISHED TO THE HOST) — gateway REACHES THIS OVER gRPC/REST WITHIN
# THE COMPOSE NETWORK. STILL USED AS THE LOCAL pnpm dev PORT WHEN RUNNING server OUTSIDE DOCKER.
SERVER_PORT=5000
# INTERNAL-ONLY — gateway REACHES auth-service's gRPC SERVER HERE.
SERVER_GRPC_PORT=50051

# NO GATEWAY_CONTAINER_NAME — gateway RUNS AS MULTIPLE REPLICAS BEHIND nginx NOW, SO DOCKER
# AUTO-NAMES EACH ONE (mern-setup-gateway-1, -2, -3, ...); A FIXED NAME CAN'T BE SHARED.
GATEWAY_REPLICAS=3

NGINX_CONTAINER_NAME=mern_nginx
# HOST-PUBLISHED — THE ONLY PUBLIC ENTRY POINT NOW, LOAD-BALANCING ACROSS gateway'S REPLICAS.
# CLIENT'S VITE_API_URL POINTS HERE.
GATEWAY_PORT=5003

KAFKA_CONTAINER_NAME=kafka
# INTERNAL LISTENER, USED BY server/notification-service INSIDE THE COMPOSE NETWORK ONLY.
KAFKA_PORT=9092
# HOST LISTENER, FOR CONNECTING FROM 127.0.0.1 (LOCAL pnpm dev, KAFKA CLIENT TOOLS, ETC).
KAFKA_HOST_PORT=9094

NOTIFICATION_CONTAINER_NAME=mern_notification_service
NOTIFICATION_HEALTH_PORT=5001

REALTIME_CONTAINER_NAME=mern_realtime_service
# HOST-PUBLISHED — BROWSER CLIENTS CONNECT DIRECTLY (NO GATEWAY IN FRONT OF IT YET).
REALTIME_PORT=5002

# METRICS/DASHBOARDS. GRAFANA_PORT DEFAULTS TO 3003 (NOT 3000/3001/3002) SINCE client's LOCAL
# DEV SERVER CONVENTIONALLY USES 3001 IN THIS REPO AND 3000/3002 ARE COMMON COLLISIONS WITH
# OTHER LOCAL TOOLING.
PROMETHEUS_CONTAINER_NAME=mern_prometheus
PROMETHEUS_PORT=9090

GRAFANA_CONTAINER_NAME=mern_grafana
GRAFANA_PORT=3003
GRAFANA_ADMIN_USER=admin
# CHANGE THIS BEFORE EXPOSING GRAFANA BEYOND YOUR OWN MACHINE.
GRAFANA_ADMIN_PASSWORD=admin

NETWORK_NAME=mern_network
