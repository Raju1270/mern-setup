{
  "name": "server",
  "version": "1.0.0",
  "description": "API Server",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "start": "node --env-file=.env dist/index.js",
    "dev": "nodemon",
    "build": "tsc",
    "clean": "if exist dist rmdir /s /q dist",
    "lint": "biome lint .",
    "lint:fix": "biome lint . --write",
    "format": "biome format . --write",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:fix": "biome check . --write",
    "test": "echo \"Error: no test specified\" && exit 1",
    "migrate:status": "node --env-file=.env node_modules/migrate-mongo/bin/migrate-mongo.js status",
    "migrate:up": "node --env-file=.env node_modules/migrate-mongo/bin/migrate-mongo.js up",
    "migrate:down": "node --env-file=.env node_modules/migrate-mongo/bin/migrate-mongo.js down",
    "migrate:create": "node --env-file=.env node_modules/migrate-mongo/bin/migrate-mongo.js create"
  },
  "keywords": [
    "express",
    "mongodb",
    "mongoose",
    "rest-api",
    "nodejs"
  ],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@10.17.1",
  "dependencies": {
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "@scalar/express-api-reference": "^0.10.16",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "express-mongo-sanitize": "^2.2.0",
    "helmet": "^8.1.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "kafkajs": "^2.2.4",
    "mongoose": "^9.0.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.8",
    "@types/bcryptjs": "^3.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.1",
    "migrate-mongo": "^14.0.7",
    "nodemon": "^3.1.11",
    "pino-pretty": "^13.1.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
