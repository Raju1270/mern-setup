NODE_ENV="development"
PORT="5000"

# LOCAL DEV: mongodb://127.0.0.1:27017 | DOCKER COMPOSE: mongodb://mongodb:27017
MONGO_URI="mongodb://127.0.0.1:27017"
MONGO_DB_NAME="mern_app"

# LOCAL DEV: redis://127.0.0.1:6379 | DOCKER COMPOSE: redis://redis:6379
REDIS_URL="redis://127.0.0.1:6379"

# HOW LONG /profile RESPONSES ARE CACHED IN REDIS, IN SECONDS.
PROFILE_CACHE_TTL="300"

JWT_SECRET="replace_with_a_random_string_at_least_32_characters_long"
JWT_EXPIRES_IN="1d"
BCRYPT_ROUNDS="12"

SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your_smtp_user@example.com"
SMTP_PASS="your_smtp_app_password"
SMTP_FROM_NAME="Ecommerce App"

OTP_EXPIRY_MINUTES="10"
OTP_MAX_ATTEMPTS="3"
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX="100"
AUTH_RATE_LIMIT_MAX="10"

CLIENT_URL="http://localhost:3001"
