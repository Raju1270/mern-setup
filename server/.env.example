NODE_ENV="development"
PORT="5000"

# INTERNAL-ONLY, REACHED BY gateway/ — NEVER PUBLISHED TO THE HOST IN DOCKER.
GRPC_PORT="50051"

# PINO LOG LEVEL: trace | debug | info | warn | error | fatal. DEFAULTS TO debug IN DEV, info OTHERWISE.
LOG_LEVEL="debug"

# LOCAL pnpm dev AGAINST THE DOCKERIZED 3-NODE REPLICA SET (`docker compose up -d mongo1 mongo2
# mongo3 mongo-init`) — HOST-PUBLISHED PORTS 27017/27018/27019. INSIDE DOCKER COMPOSE ITSELF
# (WHERE server RUNS AS A CONTAINER TOO), docker-compose.yml's environment: BLOCK OVERRIDES THIS
# WITH THE IN-NETWORK SEEDS INSTEAD. FOR A BARE STANDALONE mongod WITH NO REPLICA SET, USE
# "mongodb://127.0.0.1:27017" (NO ?replicaSet= PARAM) INSTEAD.
MONGO_URI="mongodb://127.0.0.1:27017,127.0.0.1:27018,127.0.0.1:27019/?replicaSet=rs0"
MONGO_DB_NAME="mern_app"

# LOCAL DEV: redis://127.0.0.1:6379 | DOCKER COMPOSE: redis://redis:6379
REDIS_URL="redis://127.0.0.1:6379"

# HOW LONG /profile RESPONSES ARE CACHED IN REDIS, IN SECONDS.
PROFILE_CACHE_TTL="300"

JWT_SECRET="replace_with_a_random_string_at_least_32_characters_long"
JWT_EXPIRES_IN="1d"
BCRYPT_ROUNDS="12"

# LOCAL DEV: 127.0.0.1:9094 (KAFKA'S HOST LISTENER) | DOCKER COMPOSE: kafka:9092
# EMAIL SENDING (SMTP) LIVES IN notification-service NOW — SEE notification-service/.env.example.
KAFKA_BROKERS="127.0.0.1:9094"

OTP_EXPIRY_MINUTES="10"
OTP_MAX_ATTEMPTS="3"

CLIENT_URL="http://localhost:3001"
