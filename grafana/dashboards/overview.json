{
  "uid": "mern-setup-overview",
  "title": "MERN Setup Overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Gateway Replicas Up",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "targets": [
        { "expr": "sum(up{job=\"gateway\"})", "refId": "A" }
      ]
    },
    {
      "id": 2,
      "title": "Total Requests/s",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "sum(rate(http_request_duration_seconds_count{job=~\"server|gateway\"}[1m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "OTP Emails Sent (total)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "targets": [
        { "expr": "sum(otp_emails_sent_total)", "refId": "A" }
      ]
    },
    {
      "id": 4,
      "title": "WebSocket Connections (sockets / users)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "targets": [
        { "expr": "sum(websocket_open_connections)", "legendFormat": "sockets", "refId": "A" },
        { "expr": "sum(websocket_connected_users)", "legendFormat": "users", "refId": "B" }
      ]
    },
    {
      "id": 5,
      "title": "HTTP Request Rate",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(http_request_duration_seconds_count[1m])) by (job, route)",
          "legendFormat": "{{job}} {{route}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "HTTP p95 Latency",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, job))",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "HTTP Error Rate (5xx)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(http_request_duration_seconds_count{status_code=~\"5..\"}[1m])) by (job)",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "gRPC p95 Duration",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(grpc_server_request_duration_seconds_bucket[5m])) by (le, method))",
          "legendFormat": "server {{method}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(grpc_client_request_duration_seconds_bucket[5m])) by (le, method))",
          "legendFormat": "gateway→server {{method}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 9,
      "title": "Kafka Publish Rate",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(kafka_messages_published_total[1m])) by (topic, status)",
          "legendFormat": "{{topic}} ({{status}})",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "title": "Kafka Consume Rate",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 20, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(kafka_messages_consumed_total[1m])) by (topic, status)",
          "legendFormat": "{{topic}} ({{status}})",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "title": "Process Memory (RSS)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 28, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(process_resident_memory_bytes) by (job)",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 12,
      "title": "Event Loop Lag",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 28, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(nodejs_eventloop_lag_seconds) by (job)",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ]
    }
  ]
}
